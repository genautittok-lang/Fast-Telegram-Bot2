# ============================================================
# DARKSHARE — Environment Variables (Railway / Production)
# Copy this file to .env for local dev. Never commit .env.
# ============================================================

# ── Core ────────────────────────────────────────────────────
NODE_ENV=production
# Railway injects PORT automatically; set only for local dev
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=change_me_to_a_long_random_string_min_32_chars

# ── Security / Encryption ───────────────────────────────────
# AES-256-GCM key for encrypting sensitive DB fields (totp_secret etc.)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Telegram Bot ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs with admin rights (e.g. 123456789,987654321)
ADMIN_IDS=

# ── Google OAuth (optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for Google OAuth callback — set to your Railway/production domain
# e.g. https://darkshare.up.railway.app  or  https://yourdomain.com
WEB_DOMAIN=

# ── AlorVPN (white-label VPN) ───────────────────────────────
# Get from https://alorvpn.fun B2B partner panel
ALOR_VPN_API_KEY=

# ── CryptoPay (crypto payments) ─────────────────────────────
CRYPTOPAY_TOKEN=

# ── OpenAI (AI features) ────────────────────────────────────
OPENAI_API_KEY=

# ── Groq (AI fallback) ──────────────────────────────────────
GROQ_API_KEY=

# ── Resend (transactional email) ────────────────────────────
RESEND_API_KEY=

# ── Web Push (browser notifications) ────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Admin password login (optional, Telegram ADMIN_IDS is preferred) ──
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# ── SEO verification tokens (optional) ─────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ── AbuseIPDB (IP reputation checks) ───────────────────────
ABUSEIPDB_API_KEY=

# ── Shodan (device/port scanning) ───────────────────────────
SHODAN_API_KEY=

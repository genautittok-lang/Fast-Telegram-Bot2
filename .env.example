# ============================================================
# DarkShare — Environment Variables (Railway / Production)
# ============================================================

# --- Core ---
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=change_me_to_a_long_random_string

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
# Comma-separated list of Telegram user IDs that get admin rights
ADMIN_IDS=

# --- AlorVPN (DarkShare VPN white-label) ---
# Get from https://alorvpn.fun B2B partner panel
ALOR_VPN_API_KEY=alor-partner-xxxxxxxxxxxxxxxxxxxxxx

# --- Stripe (optional, for card payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=

# --- MonoPay (optional) ---
MONOBANK_TOKEN=

# --- CryptoPay (optional) ---
CRYPTOPAY_TOKEN=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin password login (optional; otherwise admin via ADMIN_IDS Telegram only) ---
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# --- OpenAI (optional, for AI features) ---
OPENAI_API_KEY=

# --- Resend (optional, transactional email) ---
RESEND_API_KEY=

# --- Web Push (optional, browser notifications) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
